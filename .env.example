# --- Database (Docker Compose) ---
POSTGRES_USER=codebytoma
POSTGRES_PASSWORD=codebytoma_dev
POSTGRES_DB=codebytoma
POSTGRES_PORT=5432
DATABASE_URL=postgresql://codebytoma:codebytoma_dev@localhost:5432/codebytoma?schema=public

# --- Dashboard (chemin secret, SANS slash initial) ---
# Exemple : studio-xk7m2p → URL /studio-xk7m2p/...
# Ne jamais committer le vrai slug. Générer une chaîne longue et aléatoire.
DASHBOARD_BASE_PATH=change-me-to-a-long-random-slug

# --- Auth (mono-utilisateur) ---
# Mot de passe de seed / login démo (changé en prod)
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-me-strong-password
# Secret pour signer les cookies de session (32+ caractères aléatoires)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Émetteur factures (mentions légales PDF) ---
INVOICE_ISSUER_NAME=CodeByToma
INVOICE_ISSUER_ADDRESS=France
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_EMAIL=contact@example.com
INVOICE_VAT_NOT_APPLICABLE=true
