# --- Database ---
# Local Docker (optionnel) :
POSTGRES_USER=codebytoma
POSTGRES_PASSWORD=codebytoma_dev
POSTGRES_DB=codebytoma
POSTGRES_PORT=5432
# Neon (préféré) : `neon deploy` / `neon env pull` remplit ces valeurs.
# DATABASE_URL = pooled (app). DATABASE_URL_UNPOOLED = direct (migrations Prisma).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# --- Dashboard (chemin secret, SANS slash initial) ---
# Exemple : studio-xk7m2p → URL /studio-xk7m2p/...
# Ne jamais committer le vrai slug. Générer une chaîne longue et aléatoire.
DASHBOARD_BASE_PATH=change-me-to-a-long-random-slug

# --- Auth ---
# Admin (dashboard secret) — seed
AUTH_ADMIN_EMAIL=admin@example.com
# Politique : ≥12 car., majuscule, minuscule, chiffre (ex. ci-dessous à changer)
AUTH_ADMIN_PASSWORD=ChangeMe-Strong1
# Compte client démo (espace /espace) — seed Alice Martin
AUTH_CLIENT_PASSWORD=ClientDemo-Strong1
# Secret pour signer les cookies de session (32+ caractères aléatoires)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Assistant externe (Nori) : ingest veille / prospection ---
# Header Authorization: Bearer <cette clé> sur les routes /api/assistant/*
# (ingest, tasks, finance)
# ≥24 caractères aléatoires. Ne jamais committer la vraie valeur.
ASSISTANT_INGEST_SECRET=change-me-assistant-ingest-secret-24plus

# --- Émetteur factures (mentions légales PDF) ---
INVOICE_ISSUER_NAME=CodeByToma
INVOICE_ISSUER_ADDRESS=France
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_EMAIL=contact@example.com
INVOICE_VAT_NOT_APPLICABLE=true
